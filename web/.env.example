# Copy to .env.local (gitignored) for local dev; set the same names in Vercel → Project → Environment Variables.
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key
# Vector map ID (Google Cloud → Map Management, JavaScript, Vector, tilt + rotation) — enables rotate/tilt.
VITE_GOOGLE_MAP_ID=your-vector-map-id
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key
VITE_VALHALLA_URL=https://valhalla1.openstreetmap.de
